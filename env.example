# Required
DATABASE_URL=postgres://llmproxy:llmproxy@localhost:5435/llmproxy?sslmode=disable
# Versioned AES-256-GCM keyring for vendor keys at rest: "1:<base64 32B>[,2:...]".
# Generate: echo "1:$(head -c 32 /dev/urandom | base64)"
LLMPROXY_ENCRYPTION_KEYS=

# Servers
GRPC_ADDR=:9090
GRPC_MAX_RECV_MSG_SIZE=16777216
HTTP_ADDR=:8080
# OpenAI-compatible HTTP API (/v1/...) on HTTP_ADDR; false leaves only /healthz and /readyz.
HTTP_API_ENABLED=true
HTTP_API_TIMEOUT=5m
METRICS_ADDR=:9091
SHUTDOWN_TIMEOUT=30s
LOG_LEVEL=info

# Postgres pool bounds
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# How often replicas poll config_state for admin changes made elsewhere.
ROUTING_RELOAD_SECONDS=60

# Embedded migrations run at startup; off means applying them by hand.
AUTO_MIGRATE=true
MIGRATE_TIMEOUT=3m

# Auto-seeding for quickstart: populates initial models, rules, and dev keys when unconfigured.
AUTO_SEED=false
SEED_CLIENT_KEY=
SEED_CLIENT_NAME=dev-default
SEED_OPENAI_KEY=
OPENAI_API_KEY=
SEED_GEMINI_KEY=
GEMINI_API_KEY=
SEED_ANTHROPIC_KEY=
ANTHROPIC_API_KEY=

# Redis-backed RPM + daily token budgets. Empty REDIS_ADDR = limits NOT enforced.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=
BUDGET_GRACE_MARGIN=0.05
# Monetary spend limits (admin SetSpendLimit). open: a Redis outage lets calls
# through unmetered; closed: calls under a spend limit get 503 until it is back.
SPEND_LIMITS_FAIL_MODE=open
# Output tokens priced into the spend reservation when a call sets no max tokens.
SPEND_DEFAULT_OUTPUT_RESERVE_TOKENS=4096

# Circuit Breaker for upstream provider failure isolation (fail-fast without network IO).
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN=30s
# Dedicated per-attempt upstream timeout (e.g. 30s, 60s). 0 disables watchdog.
UPSTREAM_REQUEST_TIMEOUT=0

# Batch processing
BATCH_POLL_SECONDS=60
BATCH_MAX_ITEMS=10000
RESULTS_RETENTION_DAYS=7

# Local Node Pool
NODE_HEARTBEAT_INTERVAL_SECONDS=5
NODE_HEARTBEAT_TTL_SECONDS=15
NODE_RETENTION_TTL_DAYS=1
NODE_ALLOW_LOCALHOST_ENDPOINTS=false

# Accepted as an implicit admin key to mint the first real key; unset after.
BOOTSTRAP_ADMIN_KEY=

# Usage reporting; empty host disables it.
USAGE_COLLECTOR_HOST=
# TLS to the sink, e.g. one on Cloud Run (host:443).
USAGE_COLLECTOR_TLS=false
USAGE_PROJECT_ID=llm-proxy

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_ENABLE_TRACING=false

# OpenTelemetry
OTEL_SERVICE_NAME=llm-proxy
OTEL_EXPORTER_OTLP_ENDPOINT=

# Exact Match Cache
CACHE_ENABLED=false
CACHE_TTL=1h
CACHE_MAX_BYTES=1048576

# Guardrails & Security
GUARDRAILS_ENABLED=false
GUARDRAILS_PII_ACTION=block
GUARDRAILS_PROMPT_INJECTION_ACTION=block
# Latent guardrails: cosine similarity to known injection/jailbreak/exfiltration
# centroids. Action block|log; the JSON categories file adds to the built-ins.
GUARDRAILS_LATENT_ENABLED=false
GUARDRAILS_LATENT_THRESHOLD=0.70
GUARDRAILS_LATENT_ACTION=block
GUARDRAILS_LATENT_CATEGORIES_FILE=

# Semantic cache (needs Redis; shares CACHE_TTL / CACHE_MAX_BYTES). Requests opt
# in with enable_cache, as for the exact cache.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95
SEMANTIC_CACHE_MAX_ENTRIES=256

# Latent encoder for the two above: an OpenAI-compatible /v1/embeddings URL
# (e.g. a JEPA node). Empty or failing falls back to the local hash encoder.
LATENT_ENCODER_URL=
LATENT_ENCODER_MODEL=jepa-text
LATENT_ENCODER_API_KEY=
LATENT_ENCODER_TIMEOUT=50ms
LATENT_LOCAL_ENCODER_DIMS=512
LATENT_ENCODER_CACHE_SIZE=4096


