FROM golang:1.27.3-alpine3.23 AS builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags="-s -w -X main.version=${VERSION#v}" -o /out/ktms-node ./cmd/node-agent

FROM alpine:3.23
# ca-certificates is needed for --tls. No cloudflared here: use --expose=none with your own --endpoint.
RUN apk add --no-cache 'ca-certificates>=20261020-r0' && adduser -D -u 10001 appuser
COPY --from=builder /out/ktms-node /ktms-node
USER appuser
ENTRYPOINT ["/ktms-node"]
